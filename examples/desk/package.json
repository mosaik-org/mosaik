    "@tanstack/solid-router": "^1.170.41",
    "effect": "^4.1.2",
    "lucide-solid": "^1.70.0",
    "solid-js": "^1.9.17"
  },
  "devDependencies": {
    "@effect/vitest": "^4.1.2",
    "@pandacss/dev": "^2.2.0",
    "@types/bun": "^1.4.3",
    "postcss": "^8.5.0",
