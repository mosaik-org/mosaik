# Copy to `.env`. `bun dev` works without it (development defaults); production needs every
# value marked "required".

# Public origin of the app, as seen by browsers (required). Dev: Vite on 5173.
PUBLIC_URL=http://localhost:5173

# Secrets (required in production). Generate with: openssl rand -base64 32
AUTH_SECRET=
INTERNAL_KEY=
DB_PASSWORD_SECRET=
POSTGRES_PASSWORD=

# Postgres superuser connection used to provision service databases (dev default shown).
POSTGRES_URL=postgres://postgres:postgres@localhost:5432/postgres

# How Core's own pages (sign-in, requesting access, notification settings) look (optional).
BRAND_NAME=Mosaik
BRAND_LOGO_URL=
BRAND_COLOR=#2563eb

# First superadmin, created on startup if it does not exist.
ADMIN_EMAIL=admin@mosaik.local
ADMIN_PASSWORD=admin12345

# Microsoft Entra ID single sign-on (optional). Redirect URI: <PUBLIC_URL>/api/auth/callback/microsoft
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=
ENTRA_TENANT_ID=
# Create accounts on first SSO login (they only get the "authenticated" role).
ENTRA_ALLOW_SIGNUP=true

# E-mail (notifications service). Without SMTP_URL, e-mail messages are rejected.
# smtp://user:pass@host:587 (STARTTLS) or smtps://user:pass@host:465 (TLS); add ?pool=true to reuse connections.
# Development defaults to the Mailpit from `bun infra:up` (inbox at http://localhost:8025).
SMTP_URL=
MAIL_FROM="Mosaik <mosaik@example.com>"
# External addresses that may receive messages: empty = none (Mosaik users only), * = any,
# or a list such as example.com,*.partner.com
MAIL_ALLOWED_DOMAINS=
# Per sending app (deliveries per minute), and attempts before a delivery is marked failed.
# MESSAGES_PER_MINUTE=120
# DELIVERY_MAX_ATTEMPTS=8

# Slack app (optional): bot token (xoxb-…) with chat:write and users:read.email. Enables Slack
# channel targets and personal Slack notifications. Slack webhook and Teams targets work without it.
SLACK_BOT_TOKEN=

# Apps' files (platform service): SeaweedFS over S3. Development defaults to the SeaweedFS from
# `bun infra:up` (mosaik / dev-storage-secret). Without STORAGE_URL, apps cannot store files.
STORAGE_URL=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# How much each app may store unless an admin sets its own limit in the console.
# STORAGE_DEFAULT_LIMIT_GB=5

# AI clients (MCP server at <PUBLIC_URL>/mcp): tool calls each connected client may make a minute.
# MCP_CALLS_PER_MINUTE=120

# Jira, for the issues example (`bun dev`). Without JIRA_URL it shows sample data.
# Data Center / Server: personal access token. Cloud (*.atlassian.net): email + API token.
JIRA_URL=
JIRA_TOKEN=
JIRA_EMAIL=
JIRA_API_TOKEN=
# cloud | datacenter (detected from JIRA_URL when empty)
JIRA_FLAVOR=

# Export traces/logs (e.g. the Jaeger from `bun infra:up`).
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Development: use an external database for an app instead of a provisioned one:
# DATABASE_URL_SALES=postgres://user:password@host:5432/sales
