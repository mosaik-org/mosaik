{
  "name": "@mosaik/mosaik-ui",
  "version": "0.0.0",
  "description": "Accessible Solid components on Ark UI, styled with Panda CSS",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./preset": "./src/theme/index.ts"
  },
  "scripts": {
    "prepare": "panda codegen --silent",
    "codegen": "panda codegen",
    "typecheck": "tsc -p . && tsc -p catalog && tsc -p test && tsc -p scripts",
    "catalog": "vite --config catalog/vite.config.ts",
    "build": "bun scripts/build.ts",
    "verify": "bun scripts/verify.ts",
    "test": "vitest run --config vitest.config.ts && vitest run --config vitest.server.config.ts"
  },
  "dependencies": {
    "@ark-ui/solid": "^5.40.0"
  },
  "peerDependencies": {
    "solid-js": "^1.9.0"
  },
  "devDependencies": {
    "@pandacss/dev": "^2.2.0",
    "@pandacss/preset-base": "^2.2.0",
    "@pandacss/preset-panda": "^2.2.0",
    "@pandacss/types": "^2.2.0",
    "@solidjs/testing-library": "^0.8.10",
    "@testing-library/user-event": "^14.6.8",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "lucide-solid": "^1.57.0",
    "postcss": "^8.5.0",
    "solid-js": "^1.9.17",
    "vite": "^8.3.4",
    "vite-plugin-solid": "^2.11.14"
  }
}
