{
  "name": "@mosaik/sdk",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "The Mosaik SDK: what every app builds on (its contract, backend, data, sign-in and API calls), with none of Mosaik's UI.",
  "exports": {
    ".": "./src/index.ts",
    "./server": "./src/server.ts",
    "./testing": "./src/testing.ts",
    "./connectors": "./src/connectors/index.ts",
    "./connectors/jira": "./src/connectors/jira.ts",
    "./connectors/jira/model": "./src/connectors/jira-model.ts",
    "./client": "./src/client.ts",
    "./solid": "./src/solid.ts",
    "./router": "./src/router.ts",
    "./build/dev": "./src/build/dev.ts",
    "./build/manifest": "./src/build/manifest.ts"
  },
  "scripts": {
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@mosaik/app-kit": "workspace:*",
    "@mosaik/auth": "workspace:*",
    "@mosaik/client": "workspace:*",
    "@mosaik/connectors": "workspace:*",
    "@mosaik/core": "workspace:*",
    "@mosaik/db": "workspace:*",
    "@mosaik/platform": "workspace:*",
    "@mosaik/server": "workspace:*",
    "@mosaik/testing": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "^1.4.3",
    "vite": "^8.3.4"
  }
}
